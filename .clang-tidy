# The checks that catch something, and none of the ones that only make work.
#
#   just lint
#
# Needs build/compile_commands.json — `just lint` configures first.

Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  portability-*,
  misc-*,
  modernize-*,
  readability-*,

  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -misc-const-correctness,
  -misc-include-cleaner,
  -misc-use-anonymous-namespace,
  -misc-use-internal-linkage,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  -modernize-use-nodiscard,
  -portability-avoid-pragma-once,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-braces-around-statements,
  -readability-implicit-bool-conversion,
  -readability-uppercase-literal-suffix,
  -readability-use-concise-preprocessor-directives,

# Why the exclusions: raylib is a C library and takes C arrays, returns int for
# booleans and is full of numbers that mean something (44, 255, 60). A checker
# that fights the library you are using is a checker you turn off entirely,
# which is worse than turning off six of its rules.

# Every header that is not a system header: yours. raylib and raylib-cpp are
# added as SYSTEM in CMakeLists.txt, which is what keeps them out of this — a
# path pattern cannot, because raylib's headers live in a directory called src/
# too.
HeaderFilterRegex: '.*'
WarningsAsErrors: ''
FormatStyle: file
